{
  "name": "ventra",
  "version": "1.0.0",
  "description": "Security-hardened Express and Prisma backend for Ventra",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "overrides": {
    "body-parser": "2.3.0",
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
