generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventCategory {
  MUSIC
  BUSINESS
  TECHNOLOGY
  ARTS_CULTURE
  FOOD_DRINK
  SPORTS_FITNESS
  COMMUNITY
  EDUCATION
  OTHER
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  PENDING
  READY
  USED
  VOID
}

enum OutboxEventType {
  TICKET_EMAIL_REQUESTED
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  emailVerified Boolean       @default(false)
  name          String
  image         String?
  phoneNumber   String?
  role          Role          @default(USER)
  /// Set when the owner deletes the account. Personal details are scrubbed,
  /// the row stays so past events and orders keep their records.
  deletedAt     DateTime?     @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]
  events        Event[]       @relation("EventOrganizer")
  reservations  Reservation[]
  checkIns      CheckIn[]     @relation("CheckInOperator")
  organizerProfile OrganizerProfile?
  staffRoles    EventStaff[]  @relation("StaffMember")
  staffAdded    EventStaff[]  @relation("StaffAddedBy")

  @@index([role])
}

model Event {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  slug          String        @unique
  description   String
  startsAt      DateTime      @db.Timestamptz(3)
  endsAt        DateTime      @db.Timestamptz(3)
  venue         String
  category      EventCategory
  coverImageUrl String?
  city          String
  countryCode   String        @db.Char(2)
  currency      String        @db.Char(3)
  timezone      String
  status        EventStatus   @default(DRAFT)
  organizerId   String        @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  organizer     User          @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTypes   TicketType[]
  reservations  Reservation[]
  checkIns      CheckIn[]
  staff         EventStaff[]

  @@index([organizerId])
  @@index([status, startsAt])
  @@index([status, category, startsAt])
  @@index([status, countryCode, startsAt])
}

model TicketType {
  id            String   @id @default(uuid()) @db.Uuid
  eventId       String   @db.Uuid
  name          String
  description   String?
  price         Decimal  @db.Decimal(12, 2)
  capacity      Int
  reservedCount Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets       Ticket[]

  @@unique([eventId, name])
  @@index([eventId])
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String?           @db.Uuid
  eventId        String            @db.Uuid
  confirmationSentAt DateTime? @db.Timestamptz(3)
  buyerEmail     String
  buyerName      String
  idempotencyKey String
  status         ReservationStatus @default(CONFIRMED)
  /// Guest links sign this. Raising it kills every older link.
  accessVersion  Int               @default(1)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets        Ticket[]

  @@unique([buyerEmail, idempotencyKey])
  @@index([buyerEmail, createdAt])
  @@index([userId])
  @@index([eventId])
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  reservationId String       @db.Uuid
  ticketTypeId  String       @db.Uuid
  unitPrice     Decimal      @default(0) @db.Decimal(12, 2)
  publicId      String       @unique
  status        TicketStatus @default(PENDING)
  qrLocation    String?
  qrCodeDataUrl String?
  emailSentAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketType    TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  checkIn       CheckIn?

  @@index([reservationId])
  @@index([ticketTypeId])
}

model CheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @unique @db.Uuid
  eventId       String   @db.Uuid
  checkedInById String   @db.Uuid
  checkedInAt   DateTime @default(now()) @db.Timestamptz(3)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy   User     @relation("CheckInOperator", fields: [checkedInById], references: [id], onDelete: Cascade)

  @@index([eventId, checkedInAt])
  @@index([checkedInById])
}

/// How an organizer appears on their event pages. Public.
model OrganizerProfile {
  userId          String   @id @db.Uuid
  displayName     String
  bio             String?
  logoUrl         String?
  instagramHandle String?
  xHandle         String?
  supportEmail    String?
  supportPhone    String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Door helpers. They can scan tickets and see check-ins for one event, nothing else.
model EventStaff {
  eventId   String   @db.Uuid
  userId    String   @db.Uuid
  addedById String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation("StaffMember", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User     @relation("StaffAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}

model OutboxEvent {
  id            String          @id @default(uuid()) @db.Uuid
  type          OutboxEventType
  aggregateId   String          @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?       @db.Timestamptz(3)
  lockedAt      DateTime?       @db.Timestamptz(3)
  lockedBy      String?
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now()) @db.Timestamptz(3)
  lastError     String?

  @@unique([type, aggregateId])
  @@index([publishedAt, nextAttemptAt, lockedAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Jwks {
  id         String    @id @default(uuid()) @db.Uuid
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?
}
