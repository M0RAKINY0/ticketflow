NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Comma-separated explicit browser origins. Wildcards are rejected.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Process-local protection for the future API routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Required by Prisma CLI when database work is introduced.
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/ventra
