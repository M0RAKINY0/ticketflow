generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventCategory {
  MUSIC
  BUSINESS
  TECHNOLOGY
  ARTS_CULTURE
  FOOD_DRINK
  SPORTS_FITNESS
  COMMUNITY
  EDUCATION
  OTHER
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum TicketStatus {
  PENDING
  READY
  USED
  VOID
}

enum OutboxEventType {
  TICKET_EMAIL_REQUESTED
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  email         String        @unique
  emailVerified Boolean       @default(false)
  name          String
  image         String?
  phoneNumber   String?
  role          Role          @default(USER)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]
  events        Event[]       @relation("EventOrganizer")
  reservations  Reservation[]
  checkIns      CheckIn[]     @relation("CheckInOperator")

  @@index([role])
}

model Event {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  description   String
  startsAt      DateTime      @db.Timestamptz(3)
  endsAt        DateTime      @db.Timestamptz(3)
  venue         String
  category      EventCategory
  coverImageUrl String?
  city          String
  countryCode   String        @db.Char(2)
  currency      String        @db.Char(3)
  timezone      String
  status        EventStatus   @default(DRAFT)
  organizerId   String        @db.Uuid
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  organizer     User          @relation("EventOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  ticketTypes   TicketType[]
  reservations  Reservation[]
  checkIns      CheckIn[]

  @@index([organizerId])
  @@index([status, startsAt])
  @@index([status, category, startsAt])
  @@index([status, countryCode, startsAt])
}

model TicketType {
  id            String        @id @default(uuid()) @db.Uuid
  eventId       String        @db.Uuid
  name          String
  description   String?
  price         Decimal       @db.Decimal(12, 2)
  capacity      Int
  reservedCount Int           @default(0)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations  Reservation[]

  @@unique([eventId, name])
  @@index([eventId])
}

model Reservation {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @db.Uuid
  eventId        String            @db.Uuid
  ticketTypeId   String            @db.Uuid
  idempotencyKey String
  status         ReservationStatus @default(CONFIRMED)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType     TicketType        @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  ticket         Ticket?

  @@unique([userId, idempotencyKey])
  @@index([eventId])
  @@index([ticketTypeId])
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  reservationId String       @unique @db.Uuid
  publicId      String       @unique
  status        TicketStatus @default(PENDING)
  qrLocation    String?
  qrCodeDataUrl String?
  emailSentAt   DateTime?    @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  checkIn       CheckIn?
}

model CheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  ticketId      String   @unique @db.Uuid
  eventId       String   @db.Uuid
  checkedInById String   @db.Uuid
  checkedInAt   DateTime @default(now()) @db.Timestamptz(3)
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkedInBy   User     @relation("CheckInOperator", fields: [checkedInById], references: [id], onDelete: Cascade)

  @@index([eventId, checkedInAt])
  @@index([checkedInById])
}

model OutboxEvent {
  id            String          @id @default(uuid()) @db.Uuid
  type          OutboxEventType
  aggregateId   String          @db.Uuid
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  publishedAt   DateTime?       @db.Timestamptz(3)
  lockedAt      DateTime?       @db.Timestamptz(3)
  lockedBy      String?
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @default(now()) @db.Timestamptz(3)
  lastError     String?

  @@unique([type, aggregateId])
  @@index([publishedAt, nextAttemptAt, lockedAt])
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model Jwks {
  id         String    @id @default(uuid()) @db.Uuid
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime? @db.Timestamptz(3)
  alg        String?
  crv        String?
}
